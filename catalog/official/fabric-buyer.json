{
  "manifest": {
    "schema_version": 1,
    "id": "org.pupujiang.fabric-buyer",
    "name": "布料买家",
    "version": "1.0.0",
    "description": "布料直播场景的官方声明式角色与主题资源包。",
    "author": "pupujiang",
    "license": "MIT",
    "min_host_version": "0.5.0b3",
    "kind": "ai-participation",
    "runtime_type": "declarative",
    "plugin_api_version": 1,
    "capabilities": [
      "chat_context",
      "host_llm",
      "persona",
      "topic_hints"
    ],
    "config_schema": {
      "persona": {
        "type": "select",
        "label": "观众角色",
        "description": "仅在当前会话中使用。",
        "required": true,
        "options": [
          "maker",
          "buyer"
        ],
        "default": "maker"
      },
      "allow_initiative": {
        "type": "checkbox",
        "label": "允许主动开启话题",
        "default": true
      }
    },
    "recommended_pacing": {
      "min_interval_seconds": 90,
      "max_interval_seconds": 300,
      "hourly_limit": 20
    },
    "resources": {
      "personas": "personas.json",
      "topics": "topics.json",
      "prompt": "prompts/context.md"
    }
  },
  "package_url": "https://github.com/pupujiang-org/pupu-danmu-plugin-fabric-buyer/releases/download/fabric-buyer-v1.0.0/fabric-buyer-1.0.0.zip",
  "sha256": "32b43825544731f542a145531ae73f1f9c155e1d48801be48ec84298b69b26e2",
  "package_size": 2699
}
