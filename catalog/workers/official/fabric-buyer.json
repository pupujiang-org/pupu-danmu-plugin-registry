{
  "manifest": {
    "schema_version": 2,
    "id": "org.pupujiang.fabric-buyer",
    "name": "布料买家 Worker",
    "version": "1.3.0",
    "description": "布料直播场景中的 Python Worker 参与插件。",
    "author": "pupujiang",
    "license": "MIT",
    "min_host_version": "0.5.0b3",
    "kind": "ai-participation",
    "runtime_type": "python-worker",
    "plugin_api_version": 2,
    "capabilities": [
      "chat.read",
      "room.read",
      "llm.generate",
      "session.config.read"
    ],
    "config_schema": {
      "persona": {
        "type": "select",
        "label": "观众角色",
        "description": "仅在当前会话中使用。",
        "required": true,
        "options": ["maker", "buyer"],
        "default": "maker"
      },
      "allow_initiative": {
        "type": "checkbox",
        "label": "允许主动开启话题",
        "default": true
      }
    },
    "recommended_pacing": {
      "min_interval_seconds": 90,
      "max_interval_seconds": 300,
      "hourly_limit": 20
    },
    "resources": {},
    "entrypoint": "fabric_buyer.entrypoint:run"
  },
  "package_url": "https://github.com/pupujiang-org/pupu-danmu-plugin-fabric-buyer/releases/download/fabric-buyer-v1.3.0/fabric-buyer-1.3.0.zip",
  "sha256": "9dcdc41a376eeee6b5036952c29e56ff447ff20b671e1c71f0b5528a7872d120",
  "package_size": 26880
}
